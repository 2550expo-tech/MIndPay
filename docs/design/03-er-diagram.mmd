  PROFILES {
    uuid id PK
    text display_name
    bigint opening_balance_satang
    bigint runway_floor_satang "FR-6 low-balance line"
    bigint monthly_budget_satang
    boolean onboarded
  }
  TRANSACTIONS {
    uuid id PK
    uuid user_id FK
    text kind "income | expense"
    bigint amount_satang "> 0"
