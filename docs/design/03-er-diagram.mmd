    text status "draft | confirmed"
    text slip_ref "FR-4 duplicate key"
    text slip_image_hash "FR-4 duplicate key"
    numeric ocr_confidence "FR-4 >= 0.80"
  }
  SAVINGS_GOALS {
    uuid id PK
    uuid user_id FK
    text title
    bigint target_satang
    bigint saved_satang
    date due_day
  }
  AI_USAGE {
    bigint id PK
    uuid user_id FK
    text kind "slip | coach"
    timestamptz created_at
  }
